function cuyy --description 'My command-line cheatsheet'
    echo -e "--- \e[36mSHELL CHEATSHEET\e[0m ---"
    echo -e "\e[34m[System]\e[0m   localip, publicip, ports, wifi, reload, clean"
    echo -e "\e[34m[Pkg]\e[0m      p (pacman), pa (paru), i (install)"
    echo -e "\e[34m[Dev]\e[0m      venv, activate, extract <file>, pj <project>"
    echo -e "\e[34m[Rice]\e[0m     conf-hypr, cf (fish), cnvim, cw (waybar), cr (rofi)"
    echo -e "\e[34m[Git]\e[0m      gs, ga, gc, gco, gb, gp, gl, lg"
    echo -e "\e[34m[Stack]\e[0m    b (bun), pn (pnpm), dk (docker), pm (podman)"
    echo -e "\e[34m[TUI]\e[0m      y (yazi), lkd (lazydocker), top, cv, pipes"
    echo -e "------------------------------------"
end
